# Execution Mode: DEMO (uses local sample data) or LIVE (queries GDELT & NewsAPI)
MODE=DEMO

# Optional NewsAPI Key (Required only for LIVE NewsAPI ingestion)
NEWSAPI_KEY=

# Local SQLite Database URL
DATABASE_URL=sqlite:///./data/risk_engine.db

# Model and Runtime Configuration
FINBERT_MODEL_NAME=ProsusAI/finbert
USE_GPU=False

# Strategic Stress Testing Impact Threshold
IMPACT_THRESHOLD_TRIGGER=7.0
